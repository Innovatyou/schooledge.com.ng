# Environment-specific credentials and licensing
application/config/database.php
application/config/purchase_key.php

# Runtime data
application/cache/*
!application/cache/index.html
application/logs/*
!application/logs/index.html
application/sessions/*
!application/sessions/index.html

# Backups and generated/private uploads
uploads/db_backup/*
!uploads/db_backup/index.html
!uploads/db_backup/.htaccess
uploads/db_temp/*
!uploads/db_temp/index.html
!uploads/db_temp/.htaccess
uploads/qr_code/*
uploads/u2fa_qrcode/*
uploads/images/student/*
!uploads/images/student/index.html
uploads/images/staff/*
!uploads/images/staff/index.html
uploads/images/parent/*
!uploads/images/parent/index.html
uploads/attachments/*/*
uploads/online_ad_documents/*
!uploads/online_ad_documents/index.html

# Local/editor files
.env
.env.*
!.env.example
.idea/
.vscode/
Thumbs.db
.DS_Store

# Dev-only test tooling (PHPUnit) - the app itself has no Composer dependencies;
# composer.json/composer.lock exist solely to install phpunit/phpunit for tests/
vendor/
.phpunit.cache/

# Firebase Admin SDK service-account keys (server-only secrets)
mobile/*-firebase-adminsdk-*.json
application/config/*-firebase-adminsdk-*.json

# Android release signing (keystore + credentials - see mobile/docs/android-signing-guide.md)
mobile/android/key.properties
mobile/android/*.jks
mobile/android/*.keystore
