rules_version = '2';

// Classmate chat security rules for the schooledgeapp Firebase project.
// See mobile/docs/firebase-setup.md's "Classmate chat (Firestore)" section
// for deployment steps and the PHP-side custom-token minting these rules
// depend on (Chat::token(), application/libraries/Firebase_auth_token.php).
//
// Every request here carries a Firebase custom-token ID token whose claims
// (request.auth.token.classroomKey / .membershipId) were set server-side by
// Chat::token() from the caller's real bearer-token identity - the client
// can never set or forge these claims itself. Everything that must be
// server-authoritative (blocks) is written only by the backend's service
// account, which authenticates via Google IAM rather than a Firebase Auth
// user token and so bypasses these rules entirely - `allow write: if false`
// on /blocks is what makes that safe: no client, however it authenticates,
// can ever write there.
service cloud.firestore {
  match /databases/{database}/documents {
    match /conversations/{conversationId} {
      allow read, update: if request.auth != null
        && resource.data.classroomKey == request.auth.token.classroomKey
        && request.auth.token.membershipId in resource.data.participantIds;
      allow create: if request.auth != null
        && request.resource.data.classroomKey == request.auth.token.classroomKey
        && request.auth.token.membershipId in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.token.membershipId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.token.membershipId
          && request.auth.token.membershipId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && !exists(/databases/$(database)/documents/blocks/$(get(/databases/$(database)/documents/conversations/$(conversationId)).data.pairKey));
      }
    }

    match /typingStatus/{docId} {
      allow read: if request.auth != null;
      // A client may only ever write its OWN typing doc - the doc id embeds
      // the writer's membershipId, so this is the only check needed.
      allow write: if request.auth != null && docId.matches('.*_' + request.auth.token.membershipId);
    }

    match /blocks/{pairKey} {
      allow read: if request.auth != null;
      allow write: if false; // backend service account only - bypasses rules entirely, see file header
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
